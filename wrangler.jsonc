{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "voc-mcp-server",
  "main": "src/index.ts",
  // 2026-08-22, not 2026-09-01 (§8): @cloudflare/vitest-pool-workers 0.22.0 pins
  // miniflare 5.20260815.0-alpha whose runtime accepts no later date. Bump both
  // together when pool-workers ships a newer runtime.
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Pin the dev port: the Supabase-registered redirect URI is
  // http://localhost:8787/callback and must keep matching exactly (§7.4).
  "dev": { "port": 8787 },
  // Real namespaces created in the Jax account (Task 7). `wrangler dev` also
  // simulates them locally, so dev never touches these.
  "kv_namespaces": [
    { "binding": "OAUTH_KV", "id": "5ec054aa684f494aada400ac5eda2c90" },
    { "binding": "VOC_SESSIONS", "id": "e14db50094a94f38b67d2a6dbf110dae" }
  ],
  // Production vars — this block is what `wrangler deploy` ships. `wrangler dev`
  // overrides both OAuth values from `.dev.vars` (local secrets win over `vars`),
  // so one config serves both environments without an `[env.*]` split.
  //
  // Both values must correspond to the *deployed* origin: `VOC_REDIRECT_URI` is
  // the callback registered against `VOC_OAUTH_CLIENT_ID` in Supabase →
  // Authentication → OAuth Apps (§7.4). Redirect URIs match exactly — no
  // wildcards.
  "vars": {
    "VOC_SUPABASE_URL": "https://mqehfyrkgyzodlqwkozf.supabase.co",
    // The production client (`Voc MCP Server`), registered with the callback
    // below (§7.4).
    "VOC_OAUTH_CLIENT_ID": "cde8bf9e-910f-4beb-9a11-9a7ce439564e",
    "VOC_REDIRECT_URI": "https://voc-mcp-server.qianjunyinggo.workers.dev/callback"
  }
}
